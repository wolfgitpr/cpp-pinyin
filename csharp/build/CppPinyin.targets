<!--
  csharp/build/CppPinyin.targets: the copy step for .NET Framework consumers.

  STATUS: OBSOLETE since 2026-10-27 (docs/DECISIONS.md D41). See the header of CppPinyin.props: the
  netstandard2.0 target these files served was revoked, nothing imports them, and they are not packed
  into the nupkg. Kept as the written-down shape of the copy step, which is the part a future .NET
  Framework leg gets wrong; never executed on a machine with .NET Framework.

  The consumer imports it AFTER Microsoft.Common.targets:

      <Import Project="...\CppPinyin.targets" />

  and gets: the recorded native library copied next to the assembly, and a build error (not a runtime
  DllNotFoundException) when the asset is missing. A missing asset that only fails at run time is the
  failure mode both the documentation and this repository's discipline reject.
-->
<Project>

  <Target Name="CppPinyinCopyNativeLibrary" BeforeTargets="Build">
    <PropertyGroup>
      <_CppPinyinNativeSource>$(MSBuildThisFileDirectory)..\runtimes\$(CppPinyinRid)\native\$(CppPinyinNativeLibrary).dll</_CppPinyinNativeSource>
    </PropertyGroup>
    <Error Condition="!Exists('$(_CppPinyinNativeSource)')"
           Text="CppPinyin: the native library was not found at '$(_CppPinyinNativeSource)'. Set CppPinyinRid (currently '$(CppPinyinRid)') or CppPinyinNativeLibrary to match the package's runtimes/&lt;rid&gt;/native/ layout." />
    <Copy SourceFiles="$(_CppPinyinNativeSource)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
